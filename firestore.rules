rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidScore(val) {
      return val is int && val >= 0 && val <= 100;
    }

    function isValidCefr(level) {
      return level in ['B1', 'B1+', 'B2'];
    }

    function isValidLearnerProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             isValidCefr(data.cefrLevel) &&
             data.learningGoal is string && data.learningGoal.size() <= 120 &&
             data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 36500 &&
             data.articlesRead is int && data.articlesRead >= 0 &&
             data.quizzesCompleted is int && data.quizzesCompleted >= 0 &&
             data.voiceSessionsCount is int && data.voiceSessionsCount >= 0 &&
             isValidScore(data.readingScore) &&
             isValidScore(data.listeningScore) &&
             isValidScore(data.speakingScore) &&
             isValidScore(data.grammarScore) &&
             isValidScore(data.vocabularyScore) &&
             data.preferredLang in ['ar', 'en'] &&
             data.translationLang in ['ar', 'fr', 'es', 'tr', 'de'] &&
             data.readingTheme in ['WARM_PAPER', 'EYE_COMFORT', 'CALM_DARK'] &&
             data.reminderEnabled is bool &&
             data.reminderHour is int && data.reminderHour >= 0 && data.reminderHour <= 23 &&
             data.reminderMinute is int && data.reminderMinute >= 0 && data.reminderMinute <= 59 &&
             (!('guardianPin' in data) || (data.guardianPin is string && data.guardianPin.size() <= 12)) &&
             data.earnedBadges is list && data.earnedBadges.size() <= 30 &&
             (data.earnedBadges.size() == 0 || data.earnedBadges[0] is string) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMistakeRecord(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.sourceType in ['VOICE', 'QUIZ', 'WRITING'] &&
             data.originalText is string && data.originalText.size() >= 1 && data.originalText.size() <= 500 &&
             data.correctedText is string && data.correctedText.size() >= 1 && data.correctedText.size() <= 500 &&
             data.errorSpan is string && data.errorSpan.size() >= 1 && data.errorSpan.size() <= 150 &&
             data.severity in ['RED_CRITICAL', 'ORANGE_MINOR'] &&
             data.category in ['PRONUNCIATION', 'GRAMMAR', 'SPELLING', 'WORD_CHOICE'] &&
             data.explanationAr is string && data.explanationAr.size() >= 1 && data.explanationAr.size() <= 600 &&
             data.explanationEn is string && data.explanationEn.size() >= 1 && data.explanationEn.size() <= 600 &&
             data.mastered is bool &&
             data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAssessmentLog(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.activityType in ['ARTICLE', 'QUIZ', 'VOICE', 'PLACEMENT', 'CHALLENGE'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
             isValidScore(data.score) &&
             data.xpEarned is int && data.xpEarned >= 0 && data.xpEarned <= 5000 &&
             data.redErrors is int && data.redErrors >= 0 && data.redErrors <= 500 &&
             data.orangeErrors is int && data.orangeErrors >= 0 && data.orangeErrors <= 500 &&
             isValidCefr(data.cefrSnapshot) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 400)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidWeeklyChallenge(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.weekKey is string && data.weekKey.size() >= 1 && data.weekKey.size() <= 20 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 300 &&
             data.targetCount is int && data.targetCount >= 1 && data.targetCount <= 500 &&
             data.currentCount is int && data.currentCount >= 0 && data.currentCount <= 500 &&
             data.xpReward is int && data.xpReward >= 0 && data.xpReward <= 5000 &&
             data.completed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             isValidCefr(data.cefrLevel) &&
             data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
             data.weeklyPoints is int && data.weeklyPoints >= 0 && data.weeklyPoints <= 1000000 &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 36500 &&
             data.badgeTitle is string && data.badgeTitle.size() <= 60 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'cefrLevel', 'learningGoal', 'xp', 'streakDays',
                         'articlesRead', 'quizzesCompleted', 'voiceSessionsCount',
                         'readingScore', 'listeningScore', 'speakingScore', 'grammarScore', 'vocabularyScore',
                         'preferredLang', 'translationLang', 'readingTheme', 'reminderEnabled',
                         'reminderHour', 'reminderMinute', 'earnedBadges', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'cefrLevel', 'learningGoal', 'xp', 'streakDays',
                         'articlesRead', 'quizzesCompleted', 'voiceSessionsCount',
                         'readingScore', 'listeningScore', 'speakingScore', 'grammarScore', 'vocabularyScore',
                         'preferredLang', 'translationLang', 'readingTheme', 'reminderEnabled',
                         'reminderHour', 'reminderMinute', 'guardianPin', 'earnedBadges', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidLearnerProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidLearnerProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'cefrLevel', 'learningGoal', 'xp', 'streakDays',
                         'articlesRead', 'quizzesCompleted', 'voiceSessionsCount',
                         'readingScore', 'listeningScore', 'speakingScore', 'grammarScore', 'vocabularyScore',
                         'preferredLang', 'translationLang', 'readingTheme', 'reminderEnabled',
                         'reminderHour', 'reminderMinute', 'guardianPin', 'earnedBadges', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /mistakes/{mistakeId} {
        allow get: if isOwner(userId) && isValidId(mistakeId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(mistakeId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'sourceType', 'originalText', 'correctedText', 'errorSpan',
                           'severity', 'category', 'explanationAr', 'explanationEn', 'mastered',
                           'reviewCount', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'sourceType', 'originalText', 'correctedText', 'errorSpan',
                           'severity', 'category', 'explanationAr', 'explanationEn', 'mastered',
                           'reviewCount', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMistakeRecord(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(mistakeId) &&
                         isValidMistakeRecord(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'mastered', 'reviewCount', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(mistakeId);
      }

      match /assessments/{assessmentId} {
        allow get: if isOwner(userId) && isValidId(assessmentId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(assessmentId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'activityType', 'title', 'score', 'xpEarned',
                           'redErrors', 'orangeErrors', 'cefrSnapshot', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'activityType', 'title', 'score', 'xpEarned',
                           'redErrors', 'orangeErrors', 'cefrSnapshot', 'notes', 'createdAt'
                         ]) &&
                         isValidAssessmentLog(incoming());

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(assessmentId);
      }

      match /challenges/{challengeId} {
        allow get: if isOwner(userId) && isValidId(challengeId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(challengeId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'weekKey', 'title', 'description', 'targetCount',
                           'currentCount', 'xpReward', 'completed', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'weekKey', 'title', 'description', 'targetCount',
                           'currentCount', 'xpReward', 'completed', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidWeeklyChallenge(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(challengeId) &&
                         isValidWeeklyChallenge(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         !existing().completed &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'currentCount', 'completed', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(challengeId);
      }
    }

    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'cefrLevel', 'xp',
                         'weeklyPoints', 'streakDays', 'badgeTitle', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'cefrLevel', 'xp',
                         'weeklyPoints', 'streakDays', 'badgeTitle', 'updatedAt'
                       ]) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'cefrLevel', 'xp', 'weeklyPoints',
                         'streakDays', 'badgeTitle', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
